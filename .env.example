# =========================================================
# CampusSpaces Full-Stack Environment Configuration
# =========================================================

# Backend Express Port
PORT=5000

# MongoDB Connection String (Local development or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/study_space_finder

# JWT Authentication Secret Key
JWT_SECRET=super_secret_jwt_university_study_space_key_2026

# Client URL (For Express CORS policy)
CLIENT_URL=http://localhost:5173

# Frontend API URL (Used by Vite in development/production)
VITE_API_URL=http://localhost:5000/api

# Optional Google Gemini AI Key (for AI Study Space Assistant)
# Leave blank to use built-in grounded campus recommendation engine
AI_API_KEY=
